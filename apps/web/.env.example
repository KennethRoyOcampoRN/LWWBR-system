# Copy to .env and fill in with the hosted Supabase project's values,
# provided by the client. Never commit .env — it's gitignored; only this
# .env.example (placeholder values) is tracked.
#
# From the Supabase project dashboard: Settings → API. This is the
# anon/public key, safe to ship in the browser bundle (unlike apps/api's
# SUPABASE_SERVICE_ROLE_KEY, which must never reach the browser) — it can
# only do what Realtime broadcast/RLS policies already allow. Used only
# to subscribe to the `property` realtime channel for live unit status
# updates (spec §9.1/§11); this app makes no other direct Supabase calls
# from the browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-public-key
