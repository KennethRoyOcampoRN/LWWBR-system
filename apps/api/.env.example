# Copy to .env and fill in. Two deployment modes share this file —
# self-hosted (the mini PC, spec.md §13 decision 11, the active default
# below) and cloud (Supabase + Netlify, spec §3.1, kept dormant — see
# the commented block at the bottom). Never commit .env — it's
# gitignored; only this .env.example (placeholder values) is tracked.

NODE_ENV=production
PORT=3001

# Local Postgres 16 (see docs/local-hosting-setup.md). No pooler needed —
# that was a serverless-cold-start workaround specific to the Netlify
# path, irrelevant to a single long-running process talking to a local
# database. DIRECT_URL can equal DATABASE_URL here; it only exists as a
# separate value for the Supabase pooled-vs-direct distinction below.
DATABASE_URL=postgresql://lwwbr:<password>@localhost:5432/lwwbr
DIRECT_URL=postgresql://lwwbr:<password>@localhost:5432/lwwbr

# Which StorageAdapter/RealtimeAdapter implementation this process
# resolves to (apps/api/src/adapters/*/index.ts). 'local'/'socketio' is
# the mini PC's own setup; set both to 'supabase' to use the cloud path
# instead (and fill in the commented Supabase block below).
STORAGE_ADAPTER=local
REALTIME_ADAPTER=socketio

# Local-disk StorageAdapter. Directory is created on first use if
# missing. Point this at wherever the mini PC's external backup drive
# expects to find it, or back it up separately — see
# docs/local-hosting-setup.md's nightly backup section.
UPLOADS_DIR=./uploads
# Signs the local-disk StorageAdapter's signed-URL tokens. Generate a
# real secret with `openssl rand -base64 48` — never reuse this
# placeholder, same rule as JWT_SECRET below.
FILE_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# The self-hosted entrypoint (src/index.ts) serves the built SPA from
# this same process/port when true — there's no separate Netlify CDN in
# this deployment. Leave false for ordinary `npm run dev` (Vite serves
# the frontend on its own port and proxies /api here).
SERVE_WEB_DIST=true

# Client decision, 2026-10-27 (spec.md §13 decision 11): the mini PC is
# plain HTTP on a closed LAN (not reachable from the public internet) —
# this is what turns off forceHttps's 403, the Secure cookie flag, and
# HSTS, all together, as one explicit, visible opt-in. Never set this on
# a cloud/internet-exposed deployment. Mitigate the resulting plain-HTTP
# credential exposure with network segmentation, not code — see
# docs/local-hosting-setup.md's wifi SSID note.
LAN_MODE=true

# Shared secret for the cron-triggered job endpoints — any random string
# locally; a real secret in production. On the mini PC, Windows Task
# Scheduler sends this in the x-job-secret header (see
# docs/local-hosting-setup.md) in place of Netlify Scheduled Functions.
JOB_SECRET=replace-with-a-random-secret

# Signs access tokens (spec §3). Generate a real secret with
# `openssl rand -base64 48` — never reuse this placeholder, even locally,
# since a weak/shared secret lets anyone forge an access token.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Client decision, 2026-10-27 (spec.md §13 decision 10): geolocation
# requires a secure origin, which LAN_MODE deliberately doesn't have —
# false here turns the whole flagging mechanism off together with
# geolocation (not just half of it — see dtr/service.ts's own comment on
# why leaving this true under LAN_MODE would flag every single clock-in
# forever). The selfie requirement is unaffected either way.
GEOFENCE_CHECK_ENABLED=false

# Owner daily digest (spec §8.3, M6) — email only, since that's the only
# channel MVP implements, and email needs real internet regardless of
# hosting mode. Leave unset if you're not testing the digest job;
# POST /jobs/owner-digest will 500 with a clear error if it tries to
# send without these. From a Resend dashboard: API Keys.
RESEND_API_KEY=replace-with-a-resend-api-key
OWNER_DIGEST_FROM_EMAIL=digest@example.com
# The web app's own public origin, used to build the digest's deep links.
# On the mini PC this is whatever LAN address/hostname staff use.
WEB_BASE_URL=http://localhost:3001

# ————————————————————————————————————————————————————————————
# Cloud mode (spec §3.1) — dormant, not deleted. Set STORAGE_ADAPTER and
# REALTIME_ADAPTER (above) to 'supabase', set LAN_MODE=false, and fill
# these in from the Supabase project dashboard (Settings → API) to use
# this path instead. The service_role key bypasses every permission
# check in this system — treat it like the database password. Never log
# it, never send it to the browser bundle.
# ————————————————————————————————————————————————————————————
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# SUPABASE_STORAGE_BUCKET=lwwbr-files
