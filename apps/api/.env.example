# Copy to .env and fill in with the hosted Supabase project's values,
# provided by the client. Never commit .env — it's gitignored; only this
# .env.example (placeholder values) is tracked. See spec §3.1.

NODE_ENV=development
PORT=3001

# Transaction pooler (6543) — used for all app queries, dev included. See
# spec §3.1: same project serves dev and (post-Pro-upgrade) production, so
# the pooled connection is used from the start rather than switched to later.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (5432) — migrations only.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# From the Supabase project dashboard: Settings → API. The service_role key
# bypasses every permission check in this system — treat it like the
# database password. Never log it, never send it to the browser bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=lwwbr-files

# Shared secret for the cron-triggered job endpoints (spec §3.1) — any
# random string locally; a real secret in production.
JOB_SECRET=local-dev-secret

# Signs access tokens (spec §3). Generate a real secret with
# `openssl rand -base64 48` — never reuse this placeholder, even locally,
# since a weak/shared secret lets anyone forge an access token.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Owner daily digest (spec §8.3, M6) — email only, since that's the only
# channel MVP implements. Leave unset locally if you're not testing the
# digest job; POST /jobs/owner-digest will 500 with a clear error if it
# tries to send without these. From a Resend dashboard: API Keys.
RESEND_API_KEY=replace-with-a-resend-api-key
OWNER_DIGEST_FROM_EMAIL=digest@example.com
# The web app's own public origin, used to build the digest's deep links
# (e.g. https://lucky-waku-waku.netlify.app in production).
WEB_BASE_URL=http://localhost:5173
