# Copy to .env and fill in with `supabase start` output (local dev) or the
# hosted Supabase project's values (M7 launch only — see spec §11.1).

NODE_ENV=development
PORT=3001

# Local: from `supabase start` output ("DB URL"). Cloud (M7): pooled 6543
# with ?pgbouncer=true&connection_limit=1 for DATABASE_URL, direct 5432 for
# DIRECT_URL — see spec §3.1.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Local: `supabase start` prints these as "API URL" and "service_role key".
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_STORAGE_BUCKET=lwwbr-files

# Shared secret for the cron-triggered job endpoints (spec §3.1) — any
# random string locally; a real secret in production.
JOB_SECRET=local-dev-secret
